  "research": [
   {
    "batch": "c48a-d",
    "album": "Mozart: Clarinet Quintet",
    "facts": [
     {
      "f": "DG 439 460-2 的版權標記寫明：單簧管五重奏 K.581 為 ℗1976，同碟的 G 小調弦樂五重奏 K.516 為 ℗1970；K.581 的單簧管是 Gervase de Peyer，K.516 由 Amadeus-Quartett 加中提琴 Cecil Aronowitz 演出。",
      "src": "https://www.discogs.com/release/738885"
     },
     {
      "f": "這份 K.581 的原始黑膠是 DG 2530 720（℗1976），同片收 Lothar Koch 的雙簧管四重奏 K.370；Amadeus-Quartett 成員為 Norbert Brainin、Siegmund Nissel、Peter Schidlof、Martin Lovett，製作 Günther Breest，錄音工程 Wolfgang Mitlehner。",
      "src": "https://www.discogs.com/release/7074651-Wolfgang-Amadeus-Mozart-Gervase-De-Peyer-Lothar-Koch-Amadeus-Quartett-Quintett-F%C3%BCr-Klarinette-Und-S"
     },
     {
      "f": "後來的 DG 429 819-2「Mozarts Meisterwerke」版同樣標示 K.370 與 K.581 為 ℗1976、長笛四重奏為 ℗1978。",
      "src": "https://www.discogs.com/release/10233575"
     },
     {
      "f": "Karl Leister 與 Amadeus-Quartett 合作錄的是布拉姆斯 B 小調單簧管五重奏 op.115，DG 139 354 SLPM，1967 至 1968 年間發行，錄音工程 Hans-Peter Schweigmann、錄音監製 Manfred Richter。",
      "src": "https://www.discogs.com/release/12324597"
     }
    ],
    "notes": ""
   }
  ],
  "published": [
   {
    "album": "Mozart: Clarinet Quintet",
    "manifest": "onboarding-manifest-c48-rescue-20260901.json",
    "desc": "Amadeus-Quartett 的四把弦樂中間，坐著單簧管家 Gervase de Peyer。Mozart 在 1789 年 9 月 29 日完成 K.581，寫給單簧管家 Anton Stadler，同年 12 月 22 日於維也納首演，由 Stadler 吹單簧管、作曲家本人拉中提琴。第二樂章 Larghetto 讓單簧管一路獨唱在弦樂的持續音上，兩邊幾乎等重。錄音由 Deutsche Grammophon 於 1976 年發行，原始黑膠編號 2530 720。",
    "sourceUrls": [
     "https://www.discogs.com/release/738885",
     "https://www.discogs.com/release/7074651-Wolfgang-Amadeus-Mozart-Gervase-De-Peyer-Lothar-Koch-Amadeus-Quartett-Quintett-F%C3%BCr-Klarinette-Und-S",
     "https://www.discogs.com/release/10233575",
     "https://www.discogs.com/release/12324597",
     "https://archive.org/details/lp_quintet-in-a-major-for-clarinet-and-string_wolfgang-amadeus-mozart-gervase-de-peyer-m",
     "https://en.wikipedia.org/wiki/Clarinet_Quintet_(Mozart)",
     "https://musicbrainz.org/release-group/a64085bf-d084-3a58-af70-7c0c07e21d19"
    ]
   }
  ]
