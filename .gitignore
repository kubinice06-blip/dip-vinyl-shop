.claude/*
!.claude/skills/
.DS_Store
data/*.log
data/*.tmp
.discogs-token
scripts/cover-audit/data/auto-refresh.log

# publish-manifest.mjs 產生的上架 payload（每次可重新產生，不入版控）
publish-stage/

# 封面版本覆核接觸表：本機用的暫存頁，repo 根目錄會被 Cloudflare Pages 部署，不可提交
cover-edition-sheet-*.html
cover-edition-thumbs/
batch-progress/pool-data/
cover-audit-sheet-*.html
# MB 覆核的中途快取。verify-mbid.mjs 每查一張就落一次檔以便續跑，
# 跑到一半的版本進版控只會製造沒有意義的 diff；跑完的結論寫進 handoff。
batch-progress/*/verify-mbid-out.json
