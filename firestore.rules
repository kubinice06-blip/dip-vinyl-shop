rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理員 = 店家本人的 Google 帳號（後台用 Firebase 登入後，token 帶 email）
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kubinice06@gmail.com';
    }

    // ── 店家內容：前台要顯示，所以所有人可讀；只有管理員可寫 ──
    match /items/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /archives/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /quiz_questions/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /reels/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /album_overrides/{id} { allow read: if true; allow write: if isAdmin(); }

    // ── 遊戲設定（對戰/roguelike 數值與升級 buff）：玩家端要讀，所有人可讀；只有管理員可寫 ──
    match /gameConfig/{id}      { allow read: if true; allow write: if isAdmin(); }

    // ── 頂級牌固定卡池（殿堂/異端/流亡 各100張名單）：後台管理用，僅管理員可寫 ──
    match /apex_pool/{id}       { allow read: if true; allow write: if isAdmin(); }

    // ── 全站抽卡目錄：任何人（含未登入玩家）都能寫入抽到的卡，後台才看得到所有人抽的 ──
    // 非個資（只有專輯名/封面/介紹），讀取開放無妨。
    //
    // 2026-08-16：原本是 `allow write: if true`，等於任何人可寫任意內容進來。
    // 未登入玩家抽卡就要寫入，所以不能要求登入；改成限制「文件形狀」，
    // 讓這裡只能當卡牌目錄用，不能被拿去塞大量垃圾資料當免費儲存空間。
    //
    // 注意：前台是用 merge 寫入，規則看到的 request.resource.data 是「合併後的完整文件」，
    // 所以欄位數上限必須涵蓋後台另外加的 tier/apex/rarity/三軸等欄位（目前合計 13 個），
    // 抓 20 留餘裕。若日後新增欄位超過上限，玩家端寫入會開始失敗，記得同步調高。
    match /card_catalog/{id} {
      allow read: if true;
      allow write: if isAdmin() || (
           request.resource.data.keys().size() <= 20
        && request.resource.data.artist is string
        && request.resource.data.artist.size() <= 200
        && request.resource.data.album is string
        && request.resource.data.album.size() <= 200
        && (!('coverUrl' in request.resource.data)
            || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 600))
        && (!('desc' in request.resource.data)
            || (request.resource.data.desc is string && request.resource.data.desc.size() <= 2000))
      );
    }

    // ── 使用量統計：僅管理員 ──
    match /api_usage/{id}       { allow read, write: if isAdmin(); }

    // ── 會員資料（含 email）：只有管理員能讀全部；會員只能讀寫自己那筆 ──
    // 管理員可寫（後台贈送抽卡券 specialDraws）；會員只能寫自己那筆
    match /users/{uid} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // ── 會員卡冊：管理員可讀（看收藏張數）；會員只能讀寫自己的 ──
    match /collections/{uid}/cards/{cardId} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── 對戰戰績：管理員可讀（看封測數據）；會員只能讀寫自己那筆 ──
    match /battleStats/{uid} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
